// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String   @id @default(cuid())
  clerkId            String   @unique
  email              String   @unique
  name               String?
  imageUrl           String?
  githubHandle       String?  @unique
  leetcodeHandle     String?
  hackerrankHandle   String?
  codeforcesHandle   String?
  xp                 Int      @default(0)

  // Aggregated stats for fast leaderboard queries
  totalCommits     Int @default(0)
  totalPRs         Int @default(0)
  totalReviews     Int @default(0)
  reviewComments   Int @default(0)
  leetcodeEasy     Int @default(0)
  leetcodeMedium   Int @default(0)
  leetcodeHard     Int @default(0)
  codeforcesRating Int @default(0)
  codeforcesSolved Int @default(0)
  hackerrankBadges Int @default(0)

  // AI-generated leaderboard title/badge
  title String?

  // Past titles history (archived weekly)
  pastTitles PastTitle[]

  // Deduplication: last successful sync timestamp per platform
  lastSyncedGitHub     DateTime?
  lastSyncedLeetCode   DateTime?
  lastSyncedCodeforces DateTime?
  lastSyncedHackerRank DateTime?
  lastBadgeCommitSync DateTime?
  lastGhostSnapshotAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activityLogs   ActivityLog[]
  skillTreeState SkillTreeState?

  ghostSnapshots GhostSnapshot[]
  dynamicNodes   DynamicSkillNode[]
  badges         Badge[]
  badgeQueues    BadgeQueue[]
  inboxMessages  InboxMessage[]
  duelsAsChallenger Duel[] @relation("Challenger")
  duelsAsOpponent   Duel[] @relation("Opponent")
  dailyActivities   DailyActivity[]
  dailyChallenges   DailyChallenge[]
  projects          Project[]
  projectQueues     ProjectQueue[]
  guildId           String?
  guild             Guild?   @relation("GuildMembers", fields: [guildId], references: [id])
  adminOfGuilds     Guild[]  @relation("GuildAdmin")

  @@index([xp])
  @@index([clerkId])
  @@index([guildId])
}

model ActivityLog {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform     String // 'GITHUB', 'LEETCODE', 'HACKERRANK', 'CODEFORCES'
  activityType String // 'COMMIT', 'PR', 'PROBLEM_SOLVED', 'CONTEST', 'BADGE'
  description  String?
  xpAwarded    Int      @default(0)
  metadata     Json? // AI classifications, diff complexity, problem tags, etc.
  timestamp    DateTime @default(now())

  // Deduplication: external ID from the platform (PR URL, submission ID, etc.)
  externalId String?

  @@index([userId])
  @@index([platform])
  @@index([timestamp])
  @@unique([userId, externalId])
}

model SkillTreeState {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  unlockedNodes String[] // Array of node IDs unlocked
  currentGrind  String? // The path they are focusing on, e.g., 'Frontend Wizard'
  progress      Json? // Map of nodeId -> progress percentage
  updatedAt     DateTime @updatedAt
}

model DynamicSkillNode {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nodeId      String   // stable AI-generated ID
  name        String
  description String
  path        String   // the "grind path" this node belongs to
  tier        Int
  positionX   Int
  positionY   Int
  requirements Json    // flexible requirement object
  xpReward    Int
  parentIds   String[] // references to other DynamicSkillNode.nodeId
  unlocked    Boolean  @default(false)
  generatedBy String   // 'ai' or 'system'
  createdAt   DateTime @default(now())

  @@index([userId])
  @@unique([userId, nodeId])
}

model GhostSnapshot {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekNumber     Int
  year           Int
  totalXP        Int
  skillBreakdown Json // { Frontend: 120, Backend: 98, ... }
  activityCounts Json // { GITHUB: { commits: 10, prs: 2 }, LEETCODE: { easy: 5, ... } }
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([weekNumber])
  @@index([year])
  @@unique([userId, weekNumber, year])
}

model WeeklyReport {
  id            String   @id @default(cuid())
  weekNumber    Int
  year          Int
  content       String   // AI-generated post-mortem markdown
  mvpName       String?
  mvpUserId     String?
  mvpXp         Int      @default(0)
  lurkerName    String?
  lurkerUserId  String?
  lurkerXp      Int      @default(0)
  totalXP       Int      @default(0)
  participants  Int      @default(0)
  rankings      Json     // [{ name, xp, activities, platforms }]
  published     Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([year])
  @@index([weekNumber])
  @@unique([weekNumber, year])
}

model Badge {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String   // e.g., "Cache Commander"
  description String   // e.g., "Built a distributed cache in C++ with 96 commits"
  rarity      String   // common | rare | epic | legendary
  color       String   // hex color for the badge glow
  icon        String   // lucide icon name
  category    String   // skill | grind | social | special
  generatedBy String   // 'ai' or 'system'
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([rarity])
}

model PastTitle {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  weekNumber Int
  year      Int
  createdAt DateTime @default(now())

  @@index([userId])
}

model BadgeQueue {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  commits   String[]
  isFirst   Boolean  @default(false)
  status    String   @default("pending") // pending | processing | done | failed
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model InboxMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // duel_request | duel_accepted | duel_declined | system | badge_earned
  title     String
  body      String
  metadata  Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([read])
}

model Duel {
  id                String   @id @default(cuid())
  challengerId      String
  challenger        User     @relation("Challenger", fields: [challengerId], references: [id], onDelete: Cascade)
  opponentId        String
  opponent          User     @relation("Opponent", fields: [opponentId], references: [id], onDelete: Cascade)
  weekNumber        Int
  year              Int
  status            String   @default("pending") // pending | active | completed | declined
  winnerId          String?
  challengerStartXP Int      @default(0)
  opponentStartXP   Int      @default(0)
  challengerEndXP   Int      @default(0)
  opponentEndXP     Int      @default(0)
  resolvedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([challengerId])
  @@index([opponentId])
  @@index([status])
}

model DailyActivity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String   // YYYY-MM-DD
  xpGained  Int      @default(0)
  platforms String[]

  @@unique([userId, date])
  @@index([userId])
}

model DailyChallenge {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        String   // YYYY-MM-DD
  description String
  platform    String
  target      Int
  current     Int      @default(0)
  completed   Boolean  @default(false)
  xpReward    Int      @default(50)
  difficulty  String   @default("medium") // easy | medium | hard
  createdAt   DateTime @default(now())

  @@index([userId])
}

model Project {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  repoUrl     String
  demoUrl     String?
  language    String?
  stars       Int      @default(0)
  forks       Int      @default(0)
  pinned      Boolean  @default(false)
  aiSummary   String?
  createdAt   DateTime @default(now())

  @@index([userId])
}

model ProjectQueue {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  repoName  String
  repoUrl   String
  status    String   @default("pending") // pending | processing | done | failed
  error     String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([status])
}

model Guild {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  iconUrl     String?
  isPublic    Boolean  @default(true)
  adminId     String
  admin       User     @relation("GuildAdmin", fields: [adminId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  members           User[]  @relation("GuildMembers")
  badges            GuildBadge[]
  duelsAsChallenger GuildDuel[] @relation("ChallengerGuild")
  duelsAsOpponent   GuildDuel[] @relation("OpponentGuild")

  @@index([slug])
  @@index([adminId])
}

model GuildDuel {
  id                String   @id @default(cuid())
  challengerGuildId String
  challengerGuild   Guild    @relation("ChallengerGuild", fields: [challengerGuildId], references: [id], onDelete: Cascade)
  opponentGuildId   String
  opponentGuild     Guild    @relation("OpponentGuild", fields: [opponentGuildId], references: [id], onDelete: Cascade)
  weekNumber        Int
  year              Int
  status            String   @default("pending") // pending | active | completed | declined
  winnerGuildId     String?
  challengerStartXP Int      @default(0)
  opponentStartXP   Int      @default(0)
  challengerEndXP   Int      @default(0)
  opponentEndXP     Int      @default(0)
  resolvedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([challengerGuildId])
  @@index([opponentGuildId])
  @@index([status])
}

model GuildBadge {
  id          String   @id @default(cuid())
  guildId     String
  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  name        String
  description String
  rarity      String
  icon        String
  color       String
  createdAt   DateTime @default(now())

  @@index([guildId])
}
